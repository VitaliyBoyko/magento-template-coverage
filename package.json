{
  "name": "@vitaliiboiko/magento-template-coverage",
  "version": "1.0.0",
  "description": "Knockout binding execution, source-line reports and DOM coverage for Magento templates",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitaliyBoyko/magento-template-coverage.git"
  },
  "homepage": "https://github.com/VitaliyBoyko/magento-template-coverage#readme",
  "bugs": {
    "url": "https://github.com/VitaliyBoyko/magento-template-coverage/issues"
  },
  "engines": {
    "node": ">=18.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "magento",
    "cypress",
    "coverage",
    "templates",
    "knockout"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./browser": "./lib/browser.js",
    "./cypress": "./cypress/support.js"
  },
  "bin": {
    "magento-template-coverage": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "cypress",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser/run.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "entities": "6.0.1",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "knockout": "3.5.1"
  }
}
